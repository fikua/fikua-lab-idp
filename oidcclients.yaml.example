# OpenID Connect Relying Party registry (see internal/oidcclients and
# OIDC_CLIENTS_PATH) — classic web Relying Parties allowed to use this
# AS's /oidc/v1/* endpoints as their login method.
#
# Copy this file, fill in real redirect_uris, and point OIDC_CLIENTS_PATH
# at it. Field names follow RFC 7591 (OAuth 2.0 Dynamic Client
# Registration Protocol) §2 — the standard vocabulary, not any one
# vendor's own registry file shape.
#
# NOT for the ATCA-attested wallet clients /oid4vci/v1/* serves — those
# need no registry entry at all (see internal/oidcclients's package doc).

clients:
  # Decidim's own login, per the Barcelona padró demo: presenting the
  # residency attestation logs the citizen in AND authorizes them, in one
  # step, without disclosing any claim to Decidim — see verifier_claims
  # below.
  - client_id: decidim-barcelona
    # Public client: PKCE (S256, mandatory for every client this AS
    # registers) replaces a shared client_secret. No secret is issued or
    # stored for this client, ever.
    token_endpoint_auth_method: none
    redirect_uris:
      - "https://decidim.fikua.com/users/auth/fikua_verifier/callback"
    scope: "openid"
    # Which OID4VP credential this client's login flow requests.
    verifier_credential_type: "urn:fikua:padro:barcelona:1"
    # Empty is deliberate, not a placeholder to fill in: this client only
    # ever learns a stable pseudonymous `sub`, never any disclosed claim
    # — see internal/oidcclients.Client.VerifierClaims's doc comment.
    verifier_claims: []
